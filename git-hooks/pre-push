#!/usr/bin/env bash
# git-hooks/pre-push
# Node y Python pueden convivir (frontend + API). Cada uno corre su suite.
# La salida del test se ve: silenciarla dejaba un fallo sin causa.

REMOTE="$1"
URL="$2"

echo "🚀 pre-push: verificando antes de push a $REMOTE ($URL)..."

EXIT_CODE=0
RAN=no

HAS_NODE=""
HAS_PYTHON=""
[ -f "package.json" ] && HAS_NODE="yes"
[ -f "pyproject.toml" ] && HAS_PYTHON="yes"
[ -f "setup.py" ] && HAS_PYTHON="yes"

if [ "$HAS_NODE" = "yes" ]; then
  RAN=yes
  if grep -q '"test"' package.json 2>/dev/null; then
    echo "  Tests JS/TS..."
    npm test
    TEST_CODE=$?
    if [ $TEST_CODE -ne 0 ]; then
      echo "  ❌ Tests JS/TS fallaron."
      EXIT_CODE=$TEST_CODE
    else
      echo "  ✓ Tests JS/TS OK."
    fi
  else
    echo "  ⚠️  Sin script 'test' en package.json. Saltando tests JS/TS."
  fi
fi

if [ "$HAS_PYTHON" = "yes" ]; then
  RAN=yes
  if command -v pytest >/dev/null 2>&1; then
    echo "  Tests Python..."
    pytest --tb=short -q
    TEST_CODE=$?
    if [ $TEST_CODE -ne 0 ]; then
      echo "  ❌ Tests Python fallaron."
      EXIT_CODE=$TEST_CODE
    else
      echo "  ✓ Tests Python OK."
    fi
  else
    echo "  ⚠️  pytest no encontrado. Saltando tests Python."
  fi
fi

if [ "$RAN" = "no" ]; then
  echo "  ⚠️  Stack no detectado. Saltando tests."
fi

if [ -f "docs/contracts/components.ts" ] && [ -x "node_modules/.bin/tsc" ]; then
  echo "  Contratos TypeScript..."
  node_modules/.bin/tsc --noEmit --strict --skipLibCheck
  CONTRACTS_CODE=$?
  if [ $CONTRACTS_CODE -ne 0 ]; then
    echo "  ❌ Contratos TypeScript inválidos."
    EXIT_CODE=$CONTRACTS_CODE
  else
    echo "  ✓ Contratos TypeScript OK."
  fi
fi

CURRENT_BRANCH=$(git branch --show-current 2>/dev/null || true)
if [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ]; then
  echo ""
  echo "  ⚠️  Push directo a main. Flujo: feature|fix|hotfix/* → PR → main"
  echo "     Si es release o hotfix intencional, continúa."
  echo ""
fi

[ $EXIT_CODE -eq 0 ] && echo "✅ pre-push: OK." || echo "❌ pre-push falló. Para saltarte: git push --no-verify"
exit $EXIT_CODE
