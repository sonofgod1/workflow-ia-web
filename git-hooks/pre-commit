#!/usr/bin/env bash
# git-hooks/pre-commit
# Corre antes de cada commit del usuario.
# Instalar con /git-setup: cp git-hooks/pre-commit .git/hooks/pre-commit
#
# Sin set -e: un lint fallido tiene que llegar al mensaje. Con set -e el
# script moría en el pipeline y el commit se rechazaba sin una línea de error.

echo "🔍 pre-commit: verificando cambios..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  echo "✓ Sin archivos staged para revisar."
  exit 0
fi

EXIT_CODE=0

# ─── 1. Archivos prohibidos ───────────────────────────────────────────────────

echo "  Verificando archivos prohibidos..."

FORBIDDEN_PATTERNS=(
  "\.env$"
  "\.env\.local$"
  "\.env\.production$"
  "\.env\.staging$"
  "node_modules/"
  "\.tsbuildinfo$"
  "\.db$"
  "\.sqlite$"
  "\.sqlite3$"
  "dist/"
  "build/"
  "\.DS_Store$"
  "Thumbs\.db$"
  "\.pem$"
  "\.key$"
  "\.p12$"
)

while IFS= read -r file; do
  [ -z "$file" ] && continue
  for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
    if printf '%s\n' "$file" | grep -qE "$pattern"; then
      echo "  ❌ Archivo prohibido en commit: $file"
      echo "     Patrón: $pattern"
      echo "     Agrega este archivo a .gitignore y quítalo del staging:"
      echo "     git rm --cached \"$file\""
      EXIT_CODE=1
    fi
  done
done <<EOF
$STAGED_FILES
EOF

if [ $EXIT_CODE -ne 0 ]; then
  exit $EXIT_CODE
fi

echo "  ✓ Sin archivos prohibidos."

# ─── 2. Detectar stack ────────────────────────────────────────────────────────

HAS_NODE=no
HAS_BIOME=no
HAS_ESLINT=no
HAS_RUFF=no
[ -f "package.json" ] && HAS_NODE=yes
[ -x "node_modules/.bin/biome" ] && HAS_BIOME=yes
[ -x "node_modules/.bin/eslint" ] && HAS_ESLINT=yes
# command -v imprime la ruta. Guardarla y compararla con "yes" hacía que
# el lint de Python no corriera nunca.
command -v ruff >/dev/null 2>&1 && HAS_RUFF=yes

# ─── 3. Lint y formato de JS/TS ───────────────────────────────────────────────

JS_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '\.(js|jsx|ts|tsx|mjs|cjs)$' || true)

if [ -n "$JS_FILES" ] && [ "$HAS_NODE" = "yes" ]; then
  if [ "$HAS_BIOME" = "yes" ]; then
    echo "  Lint JS/TS (biome)..."
    printf '%s\n' "$JS_FILES" | tr '\n' '\0' | xargs -0 node_modules/.bin/biome check --no-errors-on-unmatched
    LINT_CODE=$?
  elif [ "$HAS_ESLINT" = "yes" ]; then
    echo "  Lint JS/TS (eslint)..."
    printf '%s\n' "$JS_FILES" | tr '\n' '\0' | xargs -0 node_modules/.bin/eslint --max-warnings=0
    LINT_CODE=$?
  else
    echo "  ⚠️  Sin linter JS/TS instalado (biome o eslint). Saltando lint."
    LINT_CODE=0
  fi

  if [ $LINT_CODE -ne 0 ]; then
    echo "  ❌ Lint falló (ver salida arriba). Ejecuta: npm run lint"
    EXIT_CODE=$LINT_CODE
  else
    echo "  ✓ Lint JS/TS OK."
  fi

  # Biome ya mira el formato dentro de check. Prettier solo si el proyecto
  # lo instaló y no convive con Biome.
  if [ "$HAS_BIOME" != "yes" ] && [ -x "node_modules/.bin/prettier" ]; then
    echo "  Formato JS/TS (prettier)..."
    printf '%s\n' "$JS_FILES" | tr '\n' '\0' | xargs -0 node_modules/.bin/prettier --check
    FMT_CODE=$?
    if [ $FMT_CODE -ne 0 ]; then
      echo "  ❌ El formato no coincide. Ejecuta: npm run format"
      EXIT_CODE=$FMT_CODE
    else
      echo "  ✓ Formato JS/TS OK."
    fi
  fi
fi

# ─── 4. TypeScript type-check ─────────────────────────────────────────────────

TS_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '\.(ts|tsx)$' || true)

if [ -n "$TS_FILES" ] && [ "$HAS_NODE" = "yes" ] && [ -f "tsconfig.json" ]; then
  if [ -x "node_modules/.bin/tsc" ]; then
    echo "  Type-check TypeScript..."
    node_modules/.bin/tsc --noEmit --skipLibCheck
    TSC_CODE=$?
    if [ $TSC_CODE -ne 0 ]; then
      echo "  ❌ TypeScript: errores de tipo (ver salida arriba)."
      EXIT_CODE=$TSC_CODE
    else
      echo "  ✓ TypeScript OK."
    fi
  else
    echo "  ⚠️  tsc no encontrado en node_modules. Saltando type-check."
  fi
fi

# ─── 5. Lint y formato de Python ──────────────────────────────────────────────

PY_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '\.py$' || true)

if [ -n "$PY_FILES" ]; then
  if [ "$HAS_RUFF" = "yes" ]; then
    echo "  Lint Python (ruff)..."
    printf '%s\n' "$PY_FILES" | tr '\n' '\0' | xargs -0 ruff check --force-exclude
    RUFF_CODE=$?
    if [ $RUFF_CODE -ne 0 ]; then
      echo "  ❌ ruff falló (ver salida arriba). Ejecuta: ruff check --fix"
      EXIT_CODE=$RUFF_CODE
    else
      echo "  ✓ Python OK."
    fi

    # Ruff como linter no implica ruff format. El chequeo entra cuando la
    # config lo declara.
    if grep -q '\[tool\.ruff\.format\]' pyproject.toml 2>/dev/null \
        || { [ -f ruff.toml ] && grep -q '^\[format\]' ruff.toml; }; then
      echo "  Formato Python (ruff format)..."
      printf '%s\n' "$PY_FILES" | tr '\n' '\0' | xargs -0 ruff format --check --force-exclude
      RUFF_FMT=$?
      if [ $RUFF_FMT -ne 0 ]; then
        echo "  ❌ ruff format falló. Ejecuta: ruff format"
        EXIT_CODE=$RUFF_FMT
      else
        echo "  ✓ Formato Python OK."
      fi
    fi
  else
    echo "  ⚠️  ruff no instalado. Saltando lint de Python."
  fi
fi

# ─── Resultado final ──────────────────────────────────────────────────────────

if [ $EXIT_CODE -eq 0 ]; then
  echo "✅ pre-commit: todo OK. Procediendo con el commit."
else
  echo ""
  echo "❌ pre-commit falló. Corrige los errores antes de commitear."
  echo "   Para saltarte el hook excepcionalmente (no recomendado):"
  echo "   git commit --no-verify -m \"tu mensaje\""
fi

exit $EXIT_CODE
